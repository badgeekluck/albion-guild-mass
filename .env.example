APP_NAME="Albion Party Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
# Host port nginx listens on (docker compose)
APP_PORT=8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (docker compose "db" service) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=albion_guild
DB_USERNAME=albion
DB_PASSWORD=albion_secret
DB_ROOT_PASSWORD=albion_root_secret
# MySQL is published on 127.0.0.1 only, for local DB clients
DB_FORWARD_PORT=33306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
# Longer than the longest job (regear scan: 600s).
DB_QUEUE_RETRY_AFTER=660
FILESYSTEM_DISK=local

# --- Realtime (Laravel Reverb) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=albion-local
REVERB_APP_KEY=albion-local-key
REVERB_APP_SECRET=albion-local-secret
# Where the *server* publishes events (container-to-container).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# The *browser* connects to the same host/port as the site (nginx proxies /app to Reverb).
# Leave these empty to use the current page's host, port and scheme.
REVERB_CLIENT_HOST=
REVERB_CLIENT_PORT=
REVERB_CLIENT_SCHEME=

# --- Discord OAuth2 + guild membership check ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=
DISCORD_BOT_TOKEN=
# Optional: channel where new parties are announced and "Ping roster" messages are posted
DISCORD_ANNOUNCE_CHANNEL_ID=
# How often (minutes) a logged-in user's guild role is re-checked
DISCORD_MEMBERSHIP_RECHECK_MINUTES=15

# --- Albion killboard (regear) ---
ALBION_REGION=europe
# Find it with: php artisan app:albion-guild "Your Guild Name"
ALBION_GUILD_ID=

# --- Local testing without Discord ---
# Enables /dev/login (only works when APP_ENV=local). NEVER enable in production.
DEV_LOGIN_ENABLED=true
# Seeds demo users, builds, a template and a party on container start
APP_DEV_SEED=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
